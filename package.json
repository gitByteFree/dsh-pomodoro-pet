{
  "name": "dsh-pomodoro-pet",
  "version": "0.9.4",
  "description": "A focus companion for DeepSeek Harness Web: pomodoro timer, four-quadrant tasks, and a pet that grows with your focus.",
  "type": "module",
  "license": "MIT",
  "author": "chris",
  "homepage": "https://github.com/gitByteFree/dsh-pomodoro-pet#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gitByteFree/dsh-pomodoro-pet.git"
  },
  "bugs": {
    "url": "https://github.com/gitByteFree/dsh-pomodoro-pet/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "pomodoro",
    "focus",
    "timer",
    "tasks",
    "eisenhower",
    "pet",
    "productivity"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "pet-engine.js",
    "achievement-engine.js",
    "stats-engine.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "i18n-en.mjs",
    "agent-bridge.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
